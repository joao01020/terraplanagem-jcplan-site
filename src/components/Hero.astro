---
---

<section class="hero" id="inicio">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">— SERVIÇOS PARA CONSTRUÇÃO CIVIL</p>
      <h1 class="hero-title">Terraplanagem &amp; Demolição.</h1>
      <p class="hero-description">
        Serviços de preparação de terrenos e demolição para obras de diferentes necessidades.
      </p>

      <div class="hero-actions">
        <a href="#contato" class="hero-primary">Solicitar orçamento ↗</a>
        <a href="#servicos" class="hero-secondary">Ver serviços ↓</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="construction-scene" data-construction-scene>
        <img
          src="/images/caminhao-basculante.svg"
          alt=""
          class="scene-item scene-truck"
          loading="eager"
          decoding="async"
        />

        <img
          src="/images/entulho.png"
          alt=""
          class="scene-item scene-rubble"
          loading="eager"
          decoding="async"
        />

        <img
          src="/images/escavadeira-jcplan.svg"
          alt=""
          class="scene-item scene-excavator"
          data-excavator
          loading="eager"
          decoding="async"
        />

        <div class="scene-controls">
          <button class="scene-control" type="button" data-move-left aria-label="Segure para aproximar a escavadeira do entulho">
            &lt;
          </button>
          <button class="scene-control" type="button" data-move-right aria-label="Segure para mover a escavadeira para a direita">
            &gt;
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // A máquina se move apenas enquanto o controle estiver pressionado.
  document.querySelectorAll<HTMLElement>('[data-construction-scene]').forEach((scene) => {
    const excavator = scene.querySelector<HTMLElement>('[data-excavator]');
    const rubble = scene.querySelector<HTMLElement>('.scene-rubble');
    const leftButton = scene.querySelector<HTMLButtonElement>('[data-move-left]');
    const rightButton = scene.querySelector<HTMLButtonElement>('[data-move-right]');
    if (!excavator || !rubble || !leftButton || !rightButton) return;

    let offset = 0;
    let direction = 0;
    let frame = 0;
    let previousTime = 0;
    const speed = 95; // pixels por segundo
    const clearance = 14; // distância mínima entre concha e entulho

    const limits = () => {
      const excavatorBox = excavator.getBoundingClientRect();
      const rubbleBox = rubble.getBoundingClientRect();
      // Retira o deslocamento atual para obter a posição original do SVG.
      const initialLeft = excavatorBox.left - offset;
      // O SVG da concha fica à esquerda da máquina; não pode alcançar o entulho.
      const min = Math.min(0, rubbleBox.right + clearance - initialLeft);
      // À direita, pode ultrapassar a lateral da tela completamente.
      const max = Math.max(0, window.innerWidth + 16 - initialLeft);
      return { min, max };
    };

    const render = () => {
      excavator.style.setProperty('--excavator-offset', `${offset}px`);
    };

    const stop = () => {
      direction = 0;
      previousTime = 0;
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };

    const tick = (time: number) => {
      if (!direction) return;
      if (!previousTime) previousTime = time;
      const elapsed = Math.min((time - previousTime) / 1000, 0.05);
      previousTime = time;

      const { min, max } = limits();
      offset = Math.max(min, Math.min(max, offset + direction * speed * elapsed));
      render();
      if ((direction < 0 && offset <= min) || (direction > 0 && offset >= max)) {
        stop();
        return;
      }
      frame = requestAnimationFrame(tick);
    };

    const start = (button: HTMLButtonElement, value: number, event: PointerEvent) => {
      if (event.button !== 0) return;
      event.preventDefault();
      stop();
      direction = value;
      button.setPointerCapture(event.pointerId);
      frame = requestAnimationFrame(tick);
    };

    leftButton.addEventListener('pointerdown', (event) => start(leftButton, -1, event));
    rightButton.addEventListener('pointerdown', (event) => start(rightButton, 1, event));
    for (const button of [leftButton, rightButton]) {
      button.addEventListener('pointerup', stop);
      button.addEventListener('pointercancel', stop);
      button.addEventListener('lostpointercapture', stop);
      button.addEventListener('keydown', (event) => {
        if ((event.key === ' ' || event.key === 'Enter') && !event.repeat && !direction) {
          event.preventDefault();
          stop();
          direction = button === leftButton ? -1 : 1;
          frame = requestAnimationFrame(tick);
        }
      });
      button.addEventListener('keyup', (event) => {
        if (event.key === ' ' || event.key === 'Enter') stop();
      });
      button.addEventListener('blur', stop);
      // Não disparar ação extra quando o navegador sintetiza um clique após o toque.
      button.addEventListener('click', (event) => event.preventDefault());
    }

    const fitWithinLimits = () => {
      const { min, max } = limits();
      offset = Math.max(min, Math.min(max, offset));
      render();
    };
    window.addEventListener('resize', fitWithinLimits);
    window.addEventListener('blur', stop);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
    });
    excavator.addEventListener('load', fitWithinLimits, { once: true });
    rubble.addEventListener('load', fitWithinLimits, { once: true });
    render();
  });
</script>

<style>
  .hero {
    padding: 4.5rem 0 5rem;
    min-height: calc(100vh - 110px);
  }

  .hero-inner {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 620px) minmax(340px, 1fr);
    align-items: start;
    gap: 2.5rem;
  }

  .hero-copy {
    padding-top: 2.5rem;
    max-width: 760px;
  }

  .hero-eyebrow {
    margin: 0 0 1.35rem;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #7c756d;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    font-weight: 600;
    color: #2b2926;
  }

  .hero-description {
    margin: 1.65rem 0 0;
    max-width: 760px;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #6f685f;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.3rem;
    border-radius: 6px;
    background: #2b2926;
    color: #f5f1ea;
    text-decoration: none;
    font-weight: 500;
  }

  .hero-secondary {
    color: #6f685f;
    text-decoration: none;
    font-weight: 500;
  }

  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 430px;
    padding-top: 1rem;
  }

  .construction-scene {
    position: relative;
    width: min(640px, 100%);
    height: 390px;
  }

  .scene-item {
    position: absolute;
    display: block;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
    object-fit: contain;
    pointer-events: none;
  }

  .scene-truck {
    left: 0;
    bottom: 54px;
    width: 190px;
    z-index: 3;
  }

  .scene-rubble {
    left: 168px;
    bottom: 22px;
    width: 110px;
    z-index: 2;
  }

  .scene-excavator {
    right: 0;
    bottom: 54px;
    width: 292px;
    z-index: 1;
    transform-origin: bottom right;
    transform: translateX(var(--excavator-offset, 0px)) scale(0.92);
    will-change: transform;
  }

  .scene-controls {
    position: absolute;
    right: 22px;
    bottom: -6px;
    display: flex;
    gap: 0.75rem;
    z-index: 10;
  }

  .scene-control {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(43, 41, 38, 0.18);
    background: rgba(255, 255, 255, 0.92);
    color: #2b2926;
    font-size: 1.15rem;
    line-height: 1;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    touch-action: none;
    user-select: none;
  }

  .scene-control:hover {
    transform: translateY(-1px);
    background: #f4efe6;
    border-color: rgba(43, 41, 38, 0.28);
  }

  .scene-control:focus-visible {
    outline: 2px solid #c49b68;
    outline-offset: 2px;
  }

  :global(html.dark) .hero-title,
  :global(html[data-theme='dark']) .hero-title,
  :global(body[data-theme='dark']) .hero-title {
    color: #f1ece4;
  }

  :global(html.dark) .hero-description,
  :global(html[data-theme='dark']) .hero-description,
  :global(body[data-theme='dark']) .hero-description {
    color: #a79b8e;
  }

  :global(html.dark) .hero-eyebrow,
  :global(html[data-theme='dark']) .hero-eyebrow,
  :global(body[data-theme='dark']) .hero-eyebrow {
    color: #8d8378;
  }

  :global(html.dark) .hero-primary,
  :global(html[data-theme='dark']) .hero-primary,
  :global(body[data-theme='dark']) .hero-primary {
    background: #f1ece4;
    color: #171411;
  }

  :global(html.dark) .hero-secondary,
  :global(html[data-theme='dark']) .hero-secondary,
  :global(body[data-theme='dark']) .hero-secondary {
    color: #b79c7a;
  }

  :global(html.dark) .scene-control,
  :global(html[data-theme='dark']) .scene-control,
  :global(body[data-theme='dark']) .scene-control {
    background: rgba(23, 20, 17, 0.92);
    color: #f1ece4;
    border-color: rgba(241, 236, 228, 0.18);
    box-shadow: 0 14px 26px rgba(0, 0, 0, 0.24);
  }

  :global(html.dark) .scene-control:hover,
  :global(html[data-theme='dark']) .scene-control:hover,
  :global(body[data-theme='dark']) .scene-control:hover {
    background: rgba(38, 32, 28, 0.96);
    border-color: rgba(241, 236, 228, 0.28);
  }

  @media (max-width: 1100px) {
    .construction-scene {
      width: min(560px, 100%);
      height: 350px;
    }

    .scene-truck {
      width: 170px;
      bottom: 50px;
    }

    .scene-rubble {
      left: 150px;
      width: 102px;
      bottom: 20px;
    }

    .scene-excavator {
      width: 264px;
      bottom: 50px;
    }
  }

  @media (max-width: 980px) {
    .hero {
      padding-top: 3rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-copy {
      padding-top: 0;
      max-width: 100%;
    }

    .hero-visual {
      justify-content: flex-start;
      min-height: auto;
      padding-top: 0;
    }

    .construction-scene {
      width: min(560px, 100%);
      height: 330px;
    }
  }

  @media (max-width: 640px) {
    .construction-scene {
      width: 100%;
      height: 255px;
    }

    .scene-truck {
      width: 132px;
      bottom: 40px;
    }

    .scene-rubble {
      left: 110px;
      width: 84px;
      bottom: 14px;
    }

    .scene-excavator {
      width: 214px;
      bottom: 40px;
    }

    .scene-controls {
      right: 10px;
      bottom: -4px;
    }

    .scene-control {
      width: 36px;
      height: 36px;
    }
  }
</style>
